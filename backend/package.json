{
  "name": "apid-fastify",
  "version": "1.0.0",
  "description": "",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && tsc-alias",
    "start": "tsx src/index.ts",
    "seed": "tsx prisma/seed.ts",
    "seed:history": "tsx prisma/seed_all_history.ts",
    "seed:commodities": "tsx src/modules/commodities/metalcharts-seeder.ts",
    "seed:commodities-history": "tsx src/modules/commodities/metalcharts-history.ts",
    "seed:investing-history": "tsx scripts/seed-investing-history.ts",
    "full": "npx concurrently \"yarn dev\" \"cd ../frontend && yarn dev\"",
    "docker:start": "yarn prisma db push && yarn seed && yarn seed:history && yarn start"
  },
  "type": "module",
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/formbody": "^8.0.2",
    "@fastify/static": "^9.1.3",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^5.2.6",
    "@prisma/adapter-mariadb": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "cheerio": "^1.2.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.8.5",
    "fastify-type-provider-zod": "^6.1.0",
    "ioredis": "^5.10.1",
    "node-cron": "^4.2.1",
    "playwright": "^1.61.0",
    "prisma": "^7.8.0",
    "tsx": "^4.23.12",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/ioredis": "^4.28.10",
    "@types/node": "^25.7.0",
    "concurrently": "^10.0.3",
    "tsc-alias": "^1.8.17",
    "typescript": "^6.0.3"
  },
  "private": true,
  "resolutions": {
    "esbuild": "0.28.2"
  }
}

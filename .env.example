# Database Config
MYSQL_ROOT_PASSWORD=root
MYSQL_USER=currency_user
MYSQL_PASSWORD=currency_pass
MYSQL_DATABASE=currency_db

# Backend Database Connection (Docker default)
DATABASE_URL="mysql://currency_user:currency_pass@db:3306/currency_db"
DATABASE_USER="currency_user"
DATABASE_PASSWORD="currency_pass"
DATABASE_NAME="currency_db"
DATABASE_HOST="db"
DATABASE_PORT=3306

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# API & Frontend URLs
ADMIN_API_KEY="local-admin-key"
API_URL="http://localhost:3000/api/v2"
FRONTEND_URL="http://localhost:3001"
PORT=3000

# External Providers & Scrapers (Optional overrides)
GENERATOR_ONLINE_URL="https://generator-online.com"
CELEBRATODAY_URL="https://celebratoday.com"
TMDB_IMAGE_URL="https://image.tmdb.org/t/p/w500/"
MEMES_ANEKDOTME_URL="https://www.memify.ru/highfive/"
MEMES_SPACESIM_URL="https://spaces.im/sz/foto-i-kartinki/jumor-prikoly/"
MEMES_TOPMEMAS_API_URL="https://topmemas.top/app/load.php"
MEMES_TOPMEMAS_IMG_URL="https://topmemas.top/img/img"
CBR_API_URL="https://www.cbr.ru/scripts/XML_daily.asp"
COINBASE_API_URL="https://api.coinbase.com/v2"
MINFIN_URL="https://api.minfin.com.ua/currency/rates/nbu?locale=uk"
METALCHARTS_API_URL="https://metalcharts.org/api/prices"
SPACES_COOKIE="sid=your_spaces_sid; user_id=your_user_id; theme=dark; spacesactive=true"
